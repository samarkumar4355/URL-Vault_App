<%- include('partials/header', { title: typeof title !== 'undefined' ? title : 'Search | LinkVault' }) %>

<!-- Search Header -->
<div style="margin-bottom: 2rem;">
  <div style="margin-bottom: 1.5rem;">
    <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.25rem;">
      🔍 Search Public Links
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.95rem;">
      Search across titles, descriptions, and tags with real-time debounced search.
    </p>
  </div>

  <!-- Search & Filter Controls -->
  <form id="searchForm" action="/search" method="GET" style="display: flex; flex-direction: column; gap: 1rem; max-width: 800px;">
    <!-- Main Search Input -->
    <div style="display: flex; gap: 0.75rem;">
      <input
        type="text"
        id="searchInput"
        name="q"
        class="form-input"
        placeholder="Search links..."
        value="<%= typeof query !== 'undefined' ? query : '' %>"
        autocomplete="off"
        style="flex: 1; margin: 0;"
      >
    </div>

    <!-- Filters Row -->
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
      <!-- Category Filter -->
      <div style="flex: 1; min-width: 160px;">
        <select id="categoryFilter" name="category" class="form-input" style="margin: 0; width: 100%;">
          <option value="" <%= typeof category === 'undefined' || !category ? 'selected' : '' %>>All Categories</option>
          <option value="Programming" <%= typeof category !== 'undefined' && category === 'Programming' ? 'selected' : '' %>>Programming</option>
          <option value="AI" <%= typeof category !== 'undefined' && category === 'AI' ? 'selected' : '' %>>AI</option>
          <option value="Web Development" <%= typeof category !== 'undefined' && category === 'Web Development' ? 'selected' : '' %>>Web Development</option>
          <option value="DSA" <%= typeof category !== 'undefined' && category === 'DSA' ? 'selected' : '' %>>DSA</option>
          <option value="General" <%= typeof category !== 'undefined' && category === 'General' ? 'selected' : '' %>>General</option>
        </select>
      </div>

      <!-- Tag Filter -->
      <div style="flex: 1; min-width: 160px;">
        <input
          type="text"
          id="tagFilter"
          name="tag"
          class="form-input"
          placeholder="Filter by tag..."
          value="<%= typeof tag !== 'undefined' ? tag : '' %>"
          style="margin: 0; width: 100%;"
        >
      </div>

      <!-- Sort Options -->
      <div style="flex: 1; min-width: 140px;">
        <select id="sort" name="sort" class="form-input" style="margin: 0; width: 100%;">
          <option value="relevance" <%= typeof sort === 'undefined' || sort === 'relevance' ? 'selected' : '' %>>Relevance</option>
          <option value="likes" <%= typeof sort !== 'undefined' && sort === 'likes' ? 'selected' : '' %>>Most Liked</option>
          <option value="views" <%= typeof sort !== 'undefined' && sort === 'views' ? 'selected' : '' %>>Most Viewed</option>
          <option value="newest" <%= typeof sort !== 'undefined' && sort === 'newest' ? 'selected' : '' %>>Newest</option>
          <option value="oldest" <%= typeof sort !== 'undefined' && sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
        </select>
      </div>
    </div>
  </form>
</div>

<!-- Dynamic Search Results Container -->
<div id="searchResults">
  <% if (typeof searched !== 'undefined' && searched) { %>
    <% if (links && links.length > 0) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; margin-top: 1.5rem;">
        <% links.forEach(link => { %>
          <div class="feature-box" style="display: flex; flex-direction: column; justify-content: space-between; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.5rem;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #a5b4fc; background: var(--accent-glow); padding: 0.2rem 0.6rem; border-radius: 4px;">
                  <%= link.category || 'General' %>
                </span>
                <div style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.75rem; color: var(--text-secondary);">
                  <span>👁️ <%= link.views || 0 %> view<%= link.views === 1 ? '' : 's' %></span>
                  <span style="color: #f43f5e;">❤️ <%= link.likes || 0 %></span>
                </div>
              </div>

              <% if (link.image) { %>
                <div style="margin-bottom: 0.75rem; border-radius: 6px; overflow: hidden; max-height: 140px;">
                  <img
                    src="<%= link.image %>"
                    alt="<%= link.title %>"
                    style="width: 100%; height: 140px; object-fit: cover; display: block;"
                    onerror="this.parentElement.style.display='none'"
                    loading="lazy"
                  >
                </div>
              <% } %>

              <h2 style="font-size: 1.15rem; font-weight: 600; margin-bottom: 0.5rem; line-height: 1.3;">
                <a href="/links/<%= link._id %>" style="color: var(--text-primary); text-decoration: none;">
                  <%= link.title %>
                </a>
              </h2>

              <% if (link.description) { %>
                <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.5;">
                  <%= link.description %>
                </p>
              <% } %>
            </div>

            <div>
              <% if (link.tags && link.tags.length > 0) { %>
                <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem;">
                  <% link.tags.forEach(tagItem => { %>
                    <span style="font-size: 0.75rem; background: rgba(51, 65, 85, 0.5); color: var(--text-secondary); padding: 0.15rem 0.5rem; border-radius: 4px;">
                      #<%= tagItem %>
                    </span>
                  <% }) %>
                </div>
              <% } %>

              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 0.75rem;">
                <span>📅 <%= link.createdAt ? new Date(link.createdAt).toLocaleDateString() : '' %></span>
                <span>By <%= link.owner && link.owner.username ? link.owner.username : 'Anonymous' %></span>
              </div>

              <div style="display: flex; justify-content: flex-end; align-items: center; font-size: 0.75rem; border-top: 1px solid rgba(51, 65, 85, 0.5); padding-top: 0.75rem;">
                <a href="/links/<%= link._id %>" style="color: #60a5fa; text-decoration: none; font-weight: 500;">
                  View Details →
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p style="color: var(--text-secondary); padding: 1.5rem 0; font-size: 1rem;">No links found.</p>
    <% } %>
  <% } %>
</div>

<!-- Pagination Controls Container -->
<div id="paginationControls" style="margin-top: 2rem; display: flex; justify-content: center; align-items: center; gap: 1rem;">
  <% if (typeof searched !== 'undefined' && searched && typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
    <% if (pagination.page > 1) { %>
      <a href="/search?q=<%= encodeURIComponent(query || '') %>&category=<%= encodeURIComponent(category || '') %>&tag=<%= encodeURIComponent(tag || '') %>&sort=<%= encodeURIComponent(sort || 'relevance') %>&page=<%= pagination.page - 1 %>" class="btn" style="background: var(--bg-surface); border: 1px solid var(--border-color); color: var(--text-primary); text-decoration: none; padding: 0.5rem 1rem; border-radius: 4px;">← Previous</a>
    <% } %>
    <span style="color: var(--text-secondary); font-size: 0.9rem;">
      Page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.total %> total)
    </span>
    <% if (pagination.page < pagination.totalPages) { %>
      <a href="/search?q=<%= encodeURIComponent(query || '') %>&category=<%= encodeURIComponent(category || '') %>&tag=<%= encodeURIComponent(tag || '') %>&sort=<%= encodeURIComponent(sort || 'relevance') %>&page=<%= pagination.page + 1 %>" class="btn" style="background: var(--bg-surface); border: 1px solid var(--border-color); color: var(--text-primary); text-decoration: none; padding: 0.5rem 1rem; border-radius: 4px;">Next →</a>
    <% } %>
  <% } %>
</div>

<%- include('partials/footer') %>
