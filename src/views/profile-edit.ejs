<%- include('partials/header', { title: typeof title !== 'undefined' ? title : 'Edit Profile | LinkVault' }) %>

<div class="auth-container">
  <div class="auth-card" style="max-width: 520px;">
    <div class="auth-header">
      <div class="badge-pill">
        <span>✏️</span>
        <span>Edit Profile</span>
      </div>
      <h1 class="auth-title">Update Your Profile</h1>
      <p class="auth-subtitle">Change your display name and bio. Email cannot be changed here.</p>
    </div>

    <!-- Error alert -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error" role="alert">
        <span class="alert-icon">⚠️</span>
        <span class="alert-message"><%= error %></span>
      </div>
    <% } %>

    <form action="/profile/edit" method="POST" class="auth-form" novalidate id="profile-edit-form">

      <!-- Username — editable -->
      <div class="form-group">
        <label for="username" class="form-label">
          Username <span style="color: var(--danger);">*</span>
        </label>
        <input
          type="text"
          id="username"
          name="username"
          class="form-input"
          value="<%= user.username %>"
          minlength="3"
          maxlength="30"
          required
          autocomplete="username"
        >
        <small class="form-hint">3–30 characters.</small>
      </div>

      <!-- Email — shown read-only, not submitted -->
      <div class="form-group">
        <label class="form-label">Email</label>
        <input
          type="email"
          class="form-input"
          value="<%= user.email %>"
          disabled
          style="opacity: 0.5; cursor: not-allowed;"
        >
        <small class="form-hint">Email changes are not supported yet.</small>
      </div>

      <!-- Bio — editable -->
      <div class="form-group">
        <label for="bio" class="form-label">Bio</label>
        <textarea
          id="bio"
          name="bio"
          class="form-input"
          rows="4"
          maxlength="300"
          placeholder="Tell the community a little about yourself…"
          style="resize: vertical; min-height: 90px;"
        ><%= user.bio || '' %></textarea>
        <small class="form-hint">Max 300 characters.</small>
      </div>

      <div style="display: flex; gap: 1rem; margin-top: 0.5rem;">
        <button type="submit" class="btn btn-primary btn-block" id="save-profile-btn">Save Changes</button>
        <a href="/profile" class="btn" style="background: rgba(51, 65, 85, 0.5); text-align: center; display: block; width: 100%;">Cancel</a>
      </div>
    </form>

    <div class="auth-footer">
      <p><a href="/profile" class="auth-link">← Back to Profile</a></p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
