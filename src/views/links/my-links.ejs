<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'My Links | LinkVault' }) %>

<div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.25rem;">My Saved Links</h1>
    <p style="color: var(--text-secondary); font-size: 0.95rem;">Manage all your personal and public bookmarks in one vault.</p>
  </div>
  <a href="/links/create" class="btn btn-primary" style="margin: 0;">+ Add Link</a>
</div>

<% if (links && links.length > 0) { %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem;">
    <% links.forEach(link => { %>
      <div class="feature-box" style="display: flex; flex-direction: column; justify-content: space-between; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.5rem;">
        <div>
          <!-- Header: Category and Visibility Badge -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.4rem;">
            <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #a5b4fc; background: var(--accent-glow); padding: 0.2rem 0.6rem; border-radius: 4px;">
              <%= link.category || 'General' %>
            </span>
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: var(--text-secondary);">
              <span>👁️ <%= link.views || 0 %></span>
              <span style="color: #f43f5e;">❤️ <%= link.likes || 0 %></span>
              <span style="font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 9999px; <%= link.visibility === 'public' ? 'background: rgba(16, 185, 129, 0.15); color: #6ee7b7;' : 'background: rgba(239, 68, 68, 0.15); color: #fca5a5;' %>">
                <%= link.visibility === 'public' ? '🌐 Public' : '🔒 Private' %>
              </span>
            </div>
          </div>

          <!-- OG Image (shown only when available) -->
          <% if (link.image) { %>
            <div style="margin-bottom: 0.75rem; border-radius: 6px; overflow: hidden; max-height: 140px;">
              <img
                src="<%= link.image %>"
                alt="<%= link.title %>"
                style="width: 100%; height: 140px; object-fit: cover; display: block;"
                onerror="this.parentElement.style.display='none'"
                loading="lazy"
              >
            </div>
          <% } %>

          <!-- Title with Favicon -->
          <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
            <% const favicon = typeof getFaviconUrl === 'function' ? getFaviconUrl(link.url) : null; %>
            <% if (favicon) { %>
              <img
                src="<%= favicon %>"
                alt=""
                width="32"
                height="32"
                style="width: 32px; height: 32px; border-radius: 6px; flex-shrink: 0; object-fit: contain; background: rgba(255, 255, 255, 0.04);"
                onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-flex';"
                loading="lazy"
              >
              <span style="display: none; width: 32px; height: 32px; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0;">🔗</span>
            <% } else { %>
              <span style="display: inline-flex; width: 32px; height: 32px; align-items: center; justify-content: center; font-size: 1.25rem; flex-shrink: 0;">🔗</span>
            <% } %>
            <h2 style="font-size: 1.2rem; font-weight: 600; margin: 0; color: var(--text-primary); line-height: 1.3;">
              <%= link.title %>
            </h2>
          </div>

          <!-- Description -->
          <% if (link.description) { %>
            <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.5;">
              <%= link.description %>
            </p>
          <% } %>
        </div>

        <div>
          <!-- Destination URL link -->
          <div style="margin-bottom: 0.75rem; word-break: break-all;">
            <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" style="font-size: 0.85rem; color: #60a5fa; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem;">
              <span>🔗</span>
              <span><%= link.url %></span>
            </a>
          </div>

          <!-- Tags -->
          <% if (link.tags && link.tags.length > 0) { %>
            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem;">
              <% link.tags.forEach(tag => { %>
                <span style="font-size: 0.75rem; background: rgba(51, 65, 85, 0.5); color: var(--text-secondary); padding: 0.15rem 0.5rem; border-radius: 4px;">
                  #<%= tag %>
                </span>
              <% }) %>
            </div>
          <% } %>

          <!-- Footer: Date and Actions -->
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--text-secondary); border-top: 1px solid rgba(51, 65, 85, 0.5); padding-top: 0.75rem; margin-top: 0.5rem;">
            <span>Saved on <%= new Date(link.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
              <a href="/links/<%= link._id %>/edit" class="btn" style="padding: 0.25rem 0.7rem; font-size: 0.8rem; margin: 0; background: rgba(99, 102, 241, 0.2); border: 1px solid var(--accent); color: #c7d2fe; text-decoration: none; border-radius: 6px;">
                ✏️ Edit
              </a>
              <form method="POST" action="/links/<%= link._id %>/delete" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this link? This action cannot be undone.');">
                <button type="submit" style="padding: 0.25rem 0.7rem; font-size: 0.8rem; cursor: pointer; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.5); color: #fca5a5; border-radius: 6px; font-family: inherit;">
                  🗑️ Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="hero-card" style="margin-top: 2rem; padding: 3rem 2rem;">
    <div style="font-size: 2.5rem; margin-bottom: 1rem;">📭</div>
    <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;">You haven't saved any links yet.</h2>
    <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Add your first useful URL to start building your personal LinkVault.</p>
    <a href="/links/create" class="btn btn-primary" style="display: inline-block;">+ Add Your First Link</a>
  </div>
<% } %>

<%- include('../partials/footer') %>
