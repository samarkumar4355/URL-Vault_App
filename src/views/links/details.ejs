<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Link Details | LinkVault' }) %>

<div style="max-width: 720px; margin: 0 auto;">

  <!-- Breadcrumb -->
  <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.5rem;">
    <a href="/links" style="color: var(--text-secondary); text-decoration: none;">Public Links</a>
    &nbsp;›&nbsp; Link Details
  </p>

  <!-- Main card -->
  <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-lg); overflow: hidden;">

    <!-- OG Image (if present) -->
    <% if (link.image) { %>
      <div style="width: 100%; max-height: 240px; overflow: hidden;">
        <img
          src="<%= link.image %>"
          alt="<%= link.title %>"
          style="width: 100%; height: 240px; object-fit: cover; display: block;"
          onerror="this.parentElement.style.display='none'"
          loading="lazy"
        >
      </div>
    <% } %>

    <div style="padding: 2rem 2rem 1.5rem;">

      <!-- Badges row -->
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
        <!-- Category -->
        <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #a5b4fc; background: var(--accent-glow); padding: 0.25rem 0.7rem; border-radius: 4px;">
          <%= link.category || 'General' %>
        </span>
        <!-- Visibility -->
        <span style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.7rem; border-radius: 9999px; <%= link.visibility === 'public' ? 'background: rgba(16, 185, 129, 0.15); color: #6ee7b7;' : 'background: rgba(239, 68, 68, 0.15); color: #fca5a5;' %>">
          <%= link.visibility === 'public' ? '🌐 Public' : '🔒 Private' %>
        </span>
        <!-- Views -->
        <span style="font-size: 0.75rem; color: var(--text-secondary);">
          👁 <%= link.views %> <%= link.views === 1 ? 'view' : 'views' %>
        </span>
        <!-- Likes -->
        <span style="font-size: 0.75rem; color: #f43f5e;">
          ❤️ <span id="topLikeCount"><%= link.likes || 0 %></span>
        </span>
      </div>

      <!-- Title with Favicon -->
      <div style="display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1rem;">
        <% const favicon = typeof getFaviconUrl === 'function' ? getFaviconUrl(link.url) : null; %>
        <% if (favicon) { %>
          <img
            src="<%= favicon %>"
            alt=""
            width="36"
            height="36"
            style="width: 36px; height: 36px; border-radius: 8px; flex-shrink: 0; object-fit: contain; background: rgba(255, 255, 255, 0.04);"
            onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-flex';"
            loading="lazy"
          >
          <span style="display: none; width: 36px; height: 36px; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">🔗</span>
        <% } else { %>
          <span style="display: inline-flex; width: 36px; height: 36px; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">🔗</span>
        <% } %>
        <h1 style="font-size: 1.65rem; font-weight: 700; line-height: 1.3; margin: 0; color: var(--text-primary);">
          <%= link.title %>
        </h1>
      </div>

      <!-- Description Section (Replaces old Likes section) -->
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.85rem 1rem; margin-bottom: 1.5rem;">
        <span style="font-size: 0.8rem; color: var(--text-secondary); font-weight: 600; display: block; margin-bottom: 0.35rem;">Description</span>
        <% if (link.description && link.description.trim().length > 0) { %>
          <p style="font-size: 0.95rem; color: var(--text-primary); line-height: 1.6; margin: 0; word-break: break-word;">
            <%= link.description %>
          </p>
        <% } else { %>
          <p style="font-size: 0.9rem; color: var(--text-secondary); font-style: italic; margin: 0;">
            No description provided.
          </p>
        <% } %>
      </div>

      <!-- Clickable URL -->
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.85rem 1rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <span style="font-size: 0.8rem; color: var(--text-secondary); white-space: nowrap;">🔗 URL</span>
        <a
          href="<%= link.url %>"
          target="_blank"
          rel="noopener noreferrer"
          style="font-size: 0.9rem; color: #60a5fa; text-decoration: none; word-break: break-all;"
        ><%= link.url %></a>
      </div>

      <!-- Tags -->
      <% if (link.tags && link.tags.length > 0) { %>
        <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem;">
          <% link.tags.forEach(tag => { %>
            <span style="font-size: 0.78rem; background: rgba(51, 65, 85, 0.5); color: var(--text-secondary); padding: 0.2rem 0.6rem; border-radius: 4px;">
              #<%= tag %>
            </span>
          <% }); %>
        </div>
      <% } %>

      <!-- Meta info row with Like button on the right -->
      <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; color: var(--text-secondary); padding-top: 1rem; border-top: 1px solid rgba(51, 65, 85, 0.5); flex-wrap: wrap; gap: 0.75rem;">
        <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
          <span>
            👤 Saved by <strong style="color: var(--text-primary);"><%= link.owner && link.owner.username ? link.owner.username : 'Anonymous' %></strong>
          </span>
          <span>
            📅 <%= new Date(link.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %>
          </span>
        </div>

        <div>
          <% const loggedInUser = (typeof user !== 'undefined' && user) || (typeof currentUser !== 'undefined' && currentUser); %>
          <% if (loggedInUser) { %>
            <button
              type="button"
              id="likeBtn"
              data-link-id="<%= link._id %>"
              data-liked="<%= typeof hasLiked !== 'undefined' && hasLiked ? 'true' : 'false' %>"
              style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 6px; padding: 0.3rem 0.65rem; color: var(--text-primary); font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; font-family: inherit; transition: all 0.2s;"
              title="<%= typeof hasLiked !== 'undefined' && hasLiked ? 'Unlike' : 'Like' %>"
            >
              <span id="likeIcon"><%= typeof hasLiked !== 'undefined' && hasLiked ? '❤️' : '🤍' %></span>
              <span id="likeCount"><%= link.likes || 0 %></span>
            </button>
          <% } else { %>
            <a
              href="/auth/login"
              style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border-color); border-radius: 6px; padding: 0.3rem 0.65rem; color: var(--text-primary); font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; font-family: inherit;"
              title="Login to like"
            >
              <span id="likeIcon">🤍</span>
              <span id="likeCount"><%= link.likes || 0 %></span>
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Action footer — only shown to the owner -->
    <% if (isOwner) { %>
      <div style="border-top: 1px solid var(--border-color); padding: 1rem 2rem; display: flex; gap: 0.75rem; background: rgba(15, 23, 42, 0.4);">
        <a
          href="/links/<%= link._id %>/edit"
          class="btn"
          style="margin: 0; background: rgba(99, 102, 241, 0.2); border: 1px solid rgba(99, 102, 241, 0.4); color: #c7d2fe; font-size: 0.9rem; padding: 0.5rem 1.1rem;"
        >
          ✏️ Edit Link
        </a>
        <form
          method="POST"
          action="/links/<%= link._id %>/delete"
          style="margin: 0;"
          onsubmit="return confirm('Delete this link? This cannot be undone.');"
        >
          <button
            type="submit"
            style="padding: 0.5rem 1.1rem; font-size: 0.9rem; cursor: pointer; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #fca5a5; border-radius: 8px; font-family: inherit;"
          >
            🗑️ Delete Link
          </button>
        </form>
      </div>
    <% } %>
  </div>

  <!-- Back link -->
  <p style="margin-top: 1.5rem; font-size: 0.85rem;">
    <a href="javascript:history.back()" style="color: var(--text-secondary); text-decoration: none;">← Go back</a>
    &nbsp;·&nbsp;
    <a href="/links" style="color: var(--text-secondary); text-decoration: none;">All public links</a>
    <% const authUser = (typeof user !== 'undefined' && user) || (typeof currentUser !== 'undefined' && currentUser); %>
    <% if (authUser) { %>
      &nbsp;·&nbsp;
      <a href="/links/my" style="color: var(--text-secondary); text-decoration: none;">My links</a>
    <% } %>
  </p>

</div>

<%- include('../partials/footer') %>
