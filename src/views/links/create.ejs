<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Add New Link | LinkVault' }) %>

<div class="auth-container">
  <div class="auth-card" style="max-width: 580px;">
    <div class="auth-header">
      <div class="badge-pill">
        <span>🔗</span>
        <span>Save Resource</span>
      </div>
      <h1 class="auth-title">Add New Link</h1>
      <p class="auth-subtitle">Save a URL to your vault with custom tags and visibility options.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error" role="alert">
        <span class="alert-icon">⚠️</span>
        <span class="alert-message"><%= error %></span>
      </div>
    <% } %>

    <form action="/links" method="POST" class="auth-form" novalidate>
      <div class="form-group">
        <label for="url" class="form-label">Destination URL <span style="color: var(--danger);">*</span></label>
        <input 
          type="url" 
          id="url" 
          name="url" 
          class="form-input" 
          placeholder="https://example.com/useful-article" 
          value="<%= typeof formData !== 'undefined' && formData.url ? formData.url : '' %>"
          required
        >
      </div>

      <div class="form-group">
        <label for="title" class="form-label">Title <span style="color: var(--text-secondary); font-size: 0.8rem; font-weight: 400;">(auto-filled if blank)</span></label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          class="form-input" 
          placeholder="Leave blank to auto-detect from the URL" 
          value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>"
          maxlength="150"
        >
      </div>

      <div class="form-group">
        <label for="description" class="form-label">Description</label>
        <textarea 
          id="description" 
          name="description" 
          class="form-input" 
          rows="3" 
          placeholder="Brief summary of what this link contains..."
          maxlength="500"
          style="resize: vertical; min-height: 80px;"
        ><%= typeof formData !== 'undefined' && formData.description ? formData.description : '' %></textarea>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="category" class="form-label">Category</label>
          <input 
            type="text" 
            id="category" 
            name="category" 
            class="form-input" 
            placeholder="e.g. Backend, Design" 
            value="<%= typeof formData !== 'undefined' && formData.category ? formData.category : '' %>"
          >
        </div>

        <div class="form-group">
          <label for="tags" class="form-label">Tags</label>
          <input 
            type="text" 
            id="tags" 
            name="tags" 
            class="form-input" 
            placeholder="javascript, nodejs, db" 
            value="<%= typeof formData !== 'undefined' && formData.tags ? formData.tags : '' %>"
          >
          <small class="form-hint">Comma-separated</small>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Visibility <span style="color: var(--danger);">*</span></label>
        <div style="display: flex; gap: 1.5rem; margin-top: 0.25rem;">
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.95rem;">
            <input 
              type="radio" 
              name="visibility" 
              value="public" 
              <%= typeof formData === 'undefined' || !formData.visibility || formData.visibility === 'public' ? 'checked' : '' %>
            >
            <span>🌐 Public <small style="color: var(--text-secondary);">(Anyone can view)</small></span>
          </label>
          <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.95rem;">
            <input 
              type="radio" 
              name="visibility" 
              value="private" 
              <%= typeof formData !== 'undefined' && formData.visibility === 'private' ? 'checked' : '' %>
            >
            <span>🔒 Private <small style="color: var(--text-secondary);">(Only you)</small></span>
          </label>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block" style="margin-top: 0.5rem;">Save Link</button>
    </form>

    <div class="auth-footer">
      <p><a href="/dashboard" class="auth-link">Return to Dashboard</a></p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
