<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Public Links | LinkVault' }) %>

<div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.25rem;">Explore Public Links</h1>
    <p style="color: var(--text-secondary); font-size: 0.95rem;">Discover useful resources and links shared publicly by the community.</p>
  </div>
  <% const authUser = (typeof user !== 'undefined' && user) || (typeof currentUser !== 'undefined' && currentUser); %>
  <% if (authUser) { %>
    <a href="/links/create" class="btn btn-primary" style="margin: 0;">+ Share a Link</a>
  <% } else { %>
    <a href="/auth/login" class="btn btn-primary" style="margin: 0;">Sign In to Save Links</a>
  <% } %>
</div>

<!-- Inline search bar for quick filtering -->
<form action="/search" method="GET" style="display: flex; gap: 0.75rem; max-width: 520px; margin-bottom: 2rem;" role="search">
  <input
    type="search"
    name="q"
    class="form-input"
    placeholder="Search public links…"
    style="flex: 1; margin: 0;"
    autocomplete="off"
  >
  <button type="submit" class="btn btn-primary" style="margin: 0; white-space: nowrap; padding: 0 1.25rem;">
    Search
  </button>
</form>


<% if (links && links.length > 0) { %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem;">
    <% links.forEach(link => { %>
      <div class="feature-box" style="display: flex; flex-direction: column; justify-content: space-between; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 1.5rem;">
        <div>
          <!-- Header: Category and Public badge -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.4rem;">
            <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #a5b4fc; background: var(--accent-glow); padding: 0.2rem 0.6rem; border-radius: 4px;">
              <%= link.category || 'General' %>
            </span>
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: var(--text-secondary);">
              <span>👁️ <%= link.views || 0 %></span>
              <span style="color: #f43f5e;">❤️ <%= link.likes || 0 %></span>
              <span style="font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 9999px; background: rgba(16, 185, 129, 0.15); color: #6ee7b7;">
                🌐 Public
              </span>
            </div>
          </div>

          <!-- OG Image (shown only when available) -->
          <% if (link.image) { %>
            <div style="margin-bottom: 0.75rem; border-radius: 6px; overflow: hidden; max-height: 140px;">
              <img
                src="<%= link.image %>"
                alt="<%= link.title %>"
                style="width: 100%; height: 140px; object-fit: cover; display: block;"
                onerror="this.parentElement.style.display='none'"
                loading="lazy"
              >
            </div>
          <% } %>

          <!-- Title -->
          <h2 style="font-size: 1.2rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-primary); line-height: 1.3;">
            <%= link.title %>
          </h2>

          <!-- Description -->
          <% if (link.description) { %>
            <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1rem; line-height: 1.5;">
              <%= link.description %>
            </p>
          <% } %>
        </div>

        <div>
          <!-- Destination URL link -->
          <div style="margin-bottom: 0.75rem; word-break: break-all;">
            <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" style="font-size: 0.85rem; color: #60a5fa; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem;">
              <span>🔗</span>
              <span><%= link.url %></span>
            </a>
          </div>

          <!-- Tags -->
          <% if (link.tags && link.tags.length > 0) { %>
            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem;">
              <% link.tags.forEach(tag => { %>
                <span style="font-size: 0.75rem; background: rgba(51, 65, 85, 0.5); color: var(--text-secondary); padding: 0.15rem 0.5rem; border-radius: 4px;">
                  #<%= tag %>
                </span>
              <% }) %>
            </div>
          <% } %>

          <!-- Footer: Creator, Date & Details link -->
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--text-secondary); border-top: 1px solid rgba(51, 65, 85, 0.5); padding-top: 0.75rem;">
            <span>By <%= link.owner && link.owner.username ? link.owner.username : 'Anonymous' %></span>
            <a
              href="/links/<%= link._id %>"
              style="font-size: 0.8rem; color: #a5b4fc; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;"
            >View Details →</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="hero-card" style="margin-top: 2rem; padding: 3rem 2rem;">
    <div style="font-size: 2.5rem; margin-bottom: 1rem;">🌐</div>
    <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;">No public links available.</h2>
    <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Be the first person to share a useful resource with the community.</p>
    <% if (authUser) { %>
      <a href="/links/create" class="btn btn-primary" style="display: inline-block;">+ Share a Link</a>
    <% } else { %>
      <a href="/auth/register" class="btn btn-primary" style="display: inline-block;">Create an Account</a>
    <% } %>
  </div>
<% } %>

<%- include('../partials/footer') %>
